# Copie para .env e preencha com as credenciais do provider escolhido.
# NUNCA versione o arquivo .env real.

# ---------------------------------------------------------------------------
# Provider de LLM / Embeddings
# ---------------------------------------------------------------------------
# Escolha um provider: openai, anthropic, google, ollama
CG_LLM__PROVIDER=openai
CG_LLM__MODEL=gpt-4o
CG_LLM__API_KEY=sk-...

CG_CLASSIFIER__PROVIDER=openai
CG_CLASSIFIER__MODEL=gpt-4o-mini

CG_CODE_ANALYSIS__PROVIDER=openai
CG_CODE_ANALYSIS__MODEL=gpt-4o

CG_CODE_VERIFICATION__PROVIDER=openai
CG_CODE_VERIFICATION__MODEL=gpt-4o

CG_EMBEDDINGS__PROVIDER=openai
CG_EMBEDDINGS__MODEL=text-embedding-3-small
CG_EMBEDDINGS__API_KEY=sk-...

# Exemplo para Ollama local:
# CG_LLM__PROVIDER=ollama
# CG_LLM__MODEL=llama3.1
# CG_LLM__BASE_URL=http://localhost:11434
# CG_EMBEDDINGS__PROVIDER=ollama
# CG_EMBEDDINGS__MODEL=nomic-embed-text
# CG_EMBEDDINGS__BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Persistência Chainlit
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codexgraph

# ---------------------------------------------------------------------------
# Autenticação
# ---------------------------------------------------------------------------
# provider: none | password | google
CG_AUTH__PROVIDER=none
CHAINLIT_AUTH_SECRET=um-segredo-forte-de-pelo-menos-32-caracteres

# Para OAuth Google (opcional):
# CG_AUTH__GOOGLE_CLIENT_ID=...
# CG_AUTH__GOOGLE_CLIENT_SECRET=...

# ---------------------------------------------------------------------------
# Caminhos e tuning
# ---------------------------------------------------------------------------
CG_CODE_GRAPH__GRAPH_PATH=./code_graph.gpickle
CG_CODE_GRAPH__CHROMA_PATH=./chroma_graph_db
CG_RETRIEVAL__CODE_K=6
